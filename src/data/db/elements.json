    {"z":7,"sym":"N","name":{"zh":"氮","en":"Nitrogen"},"mass":14.007,"cat":"nonmetal","row":2,"col":15,"shells":[2,5],"color":"#3050f8","radius":0.68,"fact":{"zh":"空氣有 78% 是氮氣。","en":"78% of air is nitrogen. Plants need it to grow, so fertilizer contains it."},"use":{"zh":"植物需要氮才能長得綠油油,肥料裡就有它。"}},
    {"z":8,"sym":"O","name":{"zh":"氧","en":"Oxygen"},"mass":15.999,"cat":"nonmetal","row":2,"col":16,"shells":[2,6],"color":"#ff2a2a","radius":0.66,"fact":{"zh":"我們呼吸靠它!空氣約有 21% 是氧氣。","en":"We breathe it! Fire needs oxygen too, so covering a candle puts it out."},"use":{"zh":"火要燃燒也需要氧氣,所以蓋住蠟燭火就熄了。"}},
    {"z":9,"sym":"F","name":{"zh":"氟","en":"Fluorine"},"mass":18.998,"cat":"halogen","row":2,"col":17,"shells":[2,7],"color":"#90e050","radius":0.6,"fact":{"zh":"牙膏裡的氟可以讓牙齒更堅固,防蛀牙。","en":"Fluoride in toothpaste makes teeth stronger. It is the most reactive nonmetal."},"use":{"zh":"它是最活潑的非金屬元素。"}},
    {"z":10,"sym":"Ne","name":{"zh":"氖","en":"Neon"},"mass":20.18,"cat":"noble","row":2,"col":18,"shells":[2,8],"color":"#b3e3f5","radius":0.55,"fact":{"zh":"霓虹燈的紅橙色光就是氖氣發出來的。","en":"The red-orange glow of neon signs! It almost never makes compounds."},"use":{"zh":"氖幾乎不跟別的元素交朋友。"}},
    {"z":11,"sym":"Na","name":{"zh":"鈉","en":"Sodium"},"mass":22.99,"cat":"alkali","row":3,"col":1,"shells":[2,8,1],"color":"#ab5cf2","radius":1,"fact":{"zh":"食鹽的一半是鈉。純鈉丟進水裡會劇烈冒泡!","en":"Half of table salt. Pure sodium fizzes wildly in water!"},"use":{"zh":"鈉是很軟的銀色金屬,可以用刀切開。"}},
    {"z":12,"sym":"Mg","name":{"zh":"鎂","en":"Magnesium"},"mass":24.305,"cat":"alkaline","row":3,"col":2,"shells":[2,8,2],"color":"#8aff00","radius":0.95,"fact":{"zh":"煙火和閃光燈裡的白亮光來自鎂燃燒。","en":"Burning magnesium makes brilliant white light. Chlorophyll has a magnesium atom at its center."},"use":{"zh":"葉綠素的中心就是鎂原子。"}},
    {"z":13,"sym":"Al","name":{"zh":"鋁","en":"Aluminium"},"mass":26.982,"cat":"post","row":3,"col":13,"shells":[2,8,3],"color":"#bfa6a6","radius":0.9,"fact":{"zh":"鋁罐、鋁箔紙都是它,又輕又不容易生鏽。","en":"Cans and foil are aluminium: light and rust-resistant. The most common metal in Earth's crust."},"use":{"zh":"地殼中最多的金屬元素。"}},
